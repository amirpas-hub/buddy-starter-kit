<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.buddy.dispatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/buddy-scheduler/dispatch.sh</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/buddy-scheduler/logs/launchd-dispatch.out</string>
  <key>StandardErrorPath</key><string>__HOME__/buddy-scheduler/logs/launchd-dispatch.err</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
